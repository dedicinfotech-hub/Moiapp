Options -Indexes

# ── Ensure all files in this directory are accessible ─────────────────────────
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

# ── Pass auth headers to PHP ───────────────────────────────────────────────────
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule .* - [E=HTTP_X_AUTH_TOKEN:%{HTTP:X-Auth-Token}]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
SetEnvIf X-Auth-Token "(.*)" HTTP_X_AUTH_TOKEN=$1

# ── CORS preflight ─────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# ── API requests: serve PHP files directly (do not rewrite) ───────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/api/ [NC]
RewriteRule ^ - [L]

# ── Config directory: deny access ─────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/config/ [NC]
RewriteRule ^ - [L]

# ── Serve real files directly ─────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── Fix 403 on reload/back: folder URL → sibling .html (Next.js static export) ─
# Next.js creates both events.html and events/ for nested routes. Apache serves
# the folder on /events/ → Options -Indexes → 403 Forbidden.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond $1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ── Serve remaining directories (_next/, uploads/, etc.) ──────────────────────
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ════════════════════════════════════════════════════════════════════════════════
# ── Dynamic slug routes → pre-built _ shell HTML files ───────────────────────
# Each pattern maps /prefix/[real-slug]/[sub-route] → /prefix/_/[sub-route].html
# ════════════════════════════════════════════════════════════════════════════════

# ── /e/[slug] public event page ───────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/e/[^/]+/?$ [NC]
RewriteRule ^ e/_.html [L]

# ── /events/[slug] (event detail — top-level only, not sub-routes) ────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/?$ [NC]
RewriteCond %{REQUEST_URI} !^/[^/]+/events/new/?$ [NC]
RewriteCond %{REQUEST_URI} !^/[^/]+/events/choose-type/?$ [NC]
RewriteCond %{REQUEST_URI} !^/[^/]+/events/create/?$ [NC]
RewriteRule ^ events/_.html [L]

# ── /events/[slug]/moi-entry ──────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/moi-entry/?$ [NC]
RewriteRule ^ events/_/moi-entry.html [L]

# ── /events/[slug]/voice-entry ────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/voice-entry/?$ [NC]
RewriteRule ^ events/_/voice-entry.html [L]

# ── /events/[slug]/gift-entry ─────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/gift-entry/?$ [NC]
RewriteRule ^ events/_/gift-entry.html [L]

# ── /events/[slug]/entries ────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/entries/?$ [NC]
RewriteRule ^ events/_/entries.html [L]

# ── /events/[slug]/dashboard ──────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/dashboard/?$ [NC]
RewriteRule ^ events/_/dashboard.html [L]

# ── /events/[slug]/dashboard-empty ───────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/dashboard-empty/?$ [NC]
RewriteRule ^ events/_/dashboard-empty.html [L]

# ── /events/[slug]/qr ─────────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/qr/?$ [NC]
RewriteRule ^ events/_/qr.html [L]

# ── /events/[slug]/pending ────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/pending/?$ [NC]
RewriteRule ^ events/_/pending.html [L]

# ── /events/[slug]/payment-method ────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/payment-method/?$ [NC]
RewriteRule ^ events/_/payment-method.html [L]

# ── /events/[slug]/invitees ───────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/invitees/?$ [NC]
RewriteRule ^ events/_/invitees.html [L]

# ── /events/[slug]/reports ────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/events/[^/]+/reports/?$ [NC]
RewriteRule ^ events/_/reports.html [L]

# ── /g/[token] guest payment page (top-level) ─────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/g/[^/]+/?$ [NC]
RewriteRule ^ g/_.html [L]

# ── /g/[token]/form ───────────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/g/[^/]+/form/?$ [NC]
RewriteRule ^ g/_/form.html [L]

# ── /g/[token]/payment ────────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/g/[^/]+/payment/?$ [NC]
RewriteRule ^ g/_/payment.html [L]

# ── /g/[token]/success ────────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/g/[^/]+/success/?$ [NC]
RewriteRule ^ g/_/success.html [L]

# ── /g/[token]/receipt ────────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/g/[^/]+/receipt/?$ [NC]
RewriteRule ^ g/_/receipt.html [L]

# ── /g/[token]/expired ────────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/g/[^/]+/expired/?$ [NC]
RewriteRule ^ g/_/expired.html [L]

# ── /g/[token]/landing ────────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/[^/]+/g/[^/]+/landing/?$ [NC]
RewriteRule ^ g/_/landing.html [L]

# ── Next.js static pages: try .html extension ─────────────────────────────────
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ── Fallback: send everything else to index.html ──────────────────────────────
RewriteRule ^ index.html [L]
