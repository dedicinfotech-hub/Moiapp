# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=moiapp

# ── App ───────────────────────────────────────────────────────────────────────
# Full URL where the PHP backend lives (no trailing slash)
APP_URL=https://dsitesai.com/moiapp

# Allowed frontend origin for CORS (no trailing slash)
# Supports multiple origins separated by commas
# Note: config/cors.php also dynamically allows any localhost/capacitor origin
CORS_ORIGIN=https://dsitesai.com,https://www.dsitesai.com,http://localhost:3000,capacitor://localhost,https://localhost,null

# ── Mail (SMTP) — Hostinger ───────────────────────────────────────────────────
# 1. hPanel → Emails → Manage → Connect Apps & Devices
# 2. Create mailbox e.g. noreply@yourdomain.com (MAIL_FROM must match this address)
# 3. Run on server: composer install (PHPMailer required for SMTP)
#
# Option A — port 587 + STARTTLS (try this first with PHPMailer)
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME=MoiApp
MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=noreply@yourdomain.com
MAIL_SMTP_PASS=your-email-account-password
MAIL_SMTP_SECURE=tls
#
# Option B — if 587 fails, use port 465 + SSL instead:
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=ssl

# ── SMS (OTP) — MSG91 recommended for India ───────────────────────────────────
# Hostinger does not provide SMS. Use MSG91 (cheapest for +91) or Twilio.
#
# MSG91 setup:
# 1. Sign up at https://msg91.com
# 2. Dashboard → API → Auth Key → copy MSG91_AUTH_KEY
# 3. Dashboard → API → IP Security → whitelist your server outbound IP
#    (on Hostinger: GET {APP_URL}/api/health.php?outbound_ip=1 to see the IP)
# 4. Register sender ID (6 chars, e.g. MOIAPP) — DLT required for production SMS in India
# 5. Route 4 = transactional OTP route
#
# Flow: phone OTP → SMS first → if SMS fails → email (if user has email on file)
# Local dev only: DEV_OTP_FALLBACK=1 returns OTP in API response (never use in production)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MOIAPP
MSG91_ROUTE=4
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
DEV_OTP_FALLBACK=0

# ── Razorpay Payments ──────────────────────────────────────────────────────────
# Required to enable guest Moi contribution payments through Razorpay Checkout.
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional but recommended for idempotent server-side payment finalization.
# Configure the same value in Razorpay Dashboard → Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── AWS S3 (optional – only needed if using photo uploads) ────────────────────
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=moiapp-photos

# Razorpay webhook URL to configure in the Razorpay dashboard:
# {APP_URL}/api/payment.php?action=webhook
# Enable events: payment.captured, payment.failed, payment.canceled, order.paid, order.failed
