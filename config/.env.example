# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=moiapp

# ── App ───────────────────────────────────────────────────────────────────────
# Full URL where the PHP backend lives (no trailing slash)
APP_URL=https://dsitesai.com/moiapp

# Allowed frontend origin for CORS (no trailing slash)
# Supports multiple origins separated by commas
# Note: config/cors.php also dynamically allows any localhost/capacitor origin
CORS_ORIGIN=https://dsitesai.com,https://www.dsitesai.com,http://localhost:3000,capacitor://localhost,https://localhost,null

# ── Mail (SMTP) ────────────────────────────────────────────────────────────────
# REQUIRED for PDF report emails and reliable OTP delivery.
# PHP mail() fallback is unreliable on most hosting environments.
# For Gmail: use an App Password (not your regular password)
#   https://myaccount.google.com/apppasswords
MAIL_FROM_EMAIL=noreply@moiapp.com
MAIL_FROM_NAME=MoiApp
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=your-email@gmail.com
MAIL_SMTP_PASS=your-app-password
MAIL_SMTP_SECURE=tls

# ── Razorpay Payments ──────────────────────────────────────────────────────────
# Required to enable guest Moi contribution payments through Razorpay Checkout.
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional but recommended for idempotent server-side payment finalization.
# Configure the same value in Razorpay Dashboard → Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── AWS S3 (optional – only needed if using photo uploads) ────────────────────
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET=moiapp-photos

# Razorpay webhook URL to configure in the Razorpay dashboard:
# {APP_URL}/api/payment.php?action=webhook
# Enable events: payment.captured, payment.failed, payment.canceled, order.paid, order.failed
