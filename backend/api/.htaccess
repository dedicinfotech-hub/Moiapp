# API directory configuration
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

# Pass auth headers to PHP
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule .* - [E=HTTP_X_AUTH_TOKEN:%{HTTP:X-Auth-Token}]
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
SetEnvIf X-Auth-Token "(.*)" HTTP_X_AUTH_TOKEN=$1

# Handle CORS preflight — let PHP handle it via config/cors.php
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^ - [L]

# Disable directory listing
Options -Indexes

# If a directory or a PHP file exists, use it directly
# (MAMP handles PHP execution globally — no SetHandler needed)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
